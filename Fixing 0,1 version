-- Помощники
function M.new(class, props, parent)
	local obj = Instance.new(class)
	for key, value in pairs(props) do
		obj[key] = value
	end
	obj.Parent = parent
	return obj
end
local new = M.new

function M.corner(parent, radius)
	return new("UICorner", { CornerRadius = UDim.new(0, radius) }, parent)
end

function M.stroke(parent, color, thickness, transparency)
	return new("UIStroke", {
		Color = color,
		Thickness = thickness or 1,
		Transparency = transparency or 0,
	}, parent)
end

function M.tw(obj, duration, props, style, direction)
	local tween = TweenService:Create(obj, TweenInfo.new(
		duration,
		style or Enum.EasingStyle.Quint,
		direction or Enum.EasingDirection.Out
	), props)
	tween:Play()
	return tween
end
local tw = M.tw

function M.bind(signal, fn)
	local connection = signal:Connect(fn)
	M.connections[#M.connections + 1] = connection
	return connection
end
local bind = M.bind


