-- Иконка из гладких примитивов: круги, кольца, скруглённые полоски.
-- Все позиции и размеры в долях (Scale), чтобы не было округления до пикселей и "ломаных" линий.
function M.icon(parent, name, color, size)
	local holder = new("Frame", {
		Name = "Icon_" .. name,
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(size, size),
		BackgroundTransparency = 1,
	}, parent)
	local G = 24
	local k = size / G
	local items = {}

	local function fillItem(obj)
		items[#items + 1] = { obj = obj, kind = "fill" }
	end
	local function strokeItem(stroke)
		items[#items + 1] = { obj = stroke, kind = "stroke" }
	end
	local function pill(obj)
		new("UICorner", { CornerRadius = UDim.new(0.5, 0) }, obj)
	end
	local function minThickness(w)
		return math.max(w * k, 1.3)
	end

	for _, op in ipairs(M.ICONS[name]) do
		local kind = op[1]
		if kind == "bar" then
			local x1, y1, x2, y2, w = op[2], op[3], op[4], op[5], op[6]
			local cx, cy = (x1 + x2) / 2, (y1 + y2) / 2
			local sx, sy, rot
			if math.abs(y2 - y1) < 0.01 then
				sx, sy, rot = math.abs(x2 - x1) + w, w, 0
			elseif math.abs(x2 - x1) < 0.01 then
				sx, sy, rot = w, math.abs(y2 - y1) + w, 0
			else
				local dx, dy = x2 - x1, y2 - y1
				sx, sy, rot = math.sqrt(dx * dx + dy * dy) + w, w, math.deg(math.atan2(dy, dx))
			end
			local bar = new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(cx / G, cy / G),
				Size = UDim2.fromScale(sx / G, sy / G),
				Rotation = rot,
				BackgroundColor3 = color,
				BorderSizePixel = 0,
			}, holder)
			pill(bar)
			if op[7] == "dim" then
				bar.BackgroundTransparency = 0.55
			end
			fillItem(bar)
		elseif kind == "dot" then
			local cx, cy, r = op[2], op[3], op[4]
			local dot = new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(cx / G, cy / G),
				Size = UDim2.fromScale(2 * r / G, 2 * r / G),
				BackgroundColor3 = color,
				BorderSizePixel = 0,
			}, holder)
			pill(dot)
			fillItem(dot)
		elseif kind == "ring" then
			local cx, cy, r, w = op[2], op[3], op[4], op[5]
			local thick = minThickness(w)
			local box = holder
			local ox, oy = 0, 0
			if op[6] then
				-- кольцо обрезается прямоугольником (получается дуга)
				box = new("Frame", {
					Position = UDim2.fromScale(op[6] / G, op[7] / G),
					Size = UDim2.fromScale(op[8] / G, op[9] / G),
					BackgroundTransparency = 1,
					ClipsDescendants = true,
				}, holder)
				ox, oy = op[6], op[7]
			end
			local frameRadius = r - (thick / k) / 2
			local ringFrame = new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
			}, box)
			if op[6] then
				ringFrame.Position = UDim2.fromScale((cx - ox) / op[8], (cy - oy) / op[9])
				ringFrame.Size = UDim2.fromScale(2 * frameRadius / op[8], 2 * frameRadius / op[9])
			else
				ringFrame.Position = UDim2.fromScale(cx / G, cy / G)
				ringFrame.Size = UDim2.fromScale(2 * frameRadius / G, 2 * frameRadius / G)
			end
			pill(ringFrame)
			strokeItem(new("UIStroke", { Color = color, Thickness = thick }, ringFrame))
		elseif kind == "rrect" then
			local x, y, w, h, rad, sw, rot = op[2], op[3], op[4], op[5], op[6], op[7], op[8]
			local thick = minThickness(sw)
			local inner = thick / k
			local rect = new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale((x + w / 2) / G, (y + h / 2) / G),
				Size = UDim2.fromScale((w - inner) / G, (h - inner) / G),
				Rotation = rot or 0,
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
			}, holder)
			new("UICorner", { CornerRadius = UDim.new(math.min(rad / math.min(w, h), 0.5), 0) }, rect)
			strokeItem(new("UIStroke", { Color = color, Thickness = thick }, rect))
		end
	end

	local scale = new("UIScale", { Scale = 1 }, holder)
	local iconObj = { holder = holder, items = items, scale = scale, color = color }

	-- Если в исполнителе есть нужные функции, рисованную иконку заменяет настоящая Lucide (PNG)
	local lucideName = M.LUCIDE[name]
	if lucideName then
		task.spawn(function()
			local assetId = M.lucideAsset(lucideName)
			if not assetId or not holder.Parent then return end
			local firstPart = holder:FindFirstChildWhichIsA("GuiObject")
			local image = new("ImageLabel", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromScale(1.08, 1.08),
				BackgroundTransparency = 1,
				Image = assetId,
				ImageColor3 = iconObj.color,
				ScaleType = Enum.ScaleType.Fit,
				ZIndex = firstPart and firstPart.ZIndex or 1,
			}, holder)
			for _, child in ipairs(holder:GetChildren()) do
				if child ~= image and child:IsA("GuiObject") then
					child.Visible = false
				end
			end
			iconObj.items = { { obj = image, kind = "image" } }
		end)
	end
	return iconObj
end

function M.tint(iconObj, color, duration)
	iconObj.color = color
	for _, item in ipairs(iconObj.items) do
		local props
		if item.kind == "fill" then
			props = { BackgroundColor3 = color }
		elseif item.kind == "image" then
			props = { ImageColor3 = color }
		else
			props = { Color = color }
		end
		if duration and duration > 0 then
			tw(item.obj, duration, props, Enum.EasingStyle.Quad)
		else
			for key, value in pairs(props) do
				item.obj[key] = value
			end
		end
	end
end

-- Настоящие иконки Lucide (PNG) из репозитория melatonin-rs/lucide-luau через jsDelivr.
-- Работает только если исполнитель умеет writefile/getcustomasset/request; иначе остаются рисованные.
M.LUCIDE = {
	sword = "sword", run = "footprints", cross = "crosshair", eye = "eye", gem = "gem",
	gear = "settings", music = "music", code = "code", resize = "move-diagonal-2",
}

function M.lucideAsset(iconName)
	if M.lucide == nil then
		if M.lucideLoading then
			local waited = 0
			while M.lucide == nil and waited < 20 do
				task.wait(0.1)
				waited = waited + 0.1
			end
		else
			M.lucideLoading = true
			local ok, module = pcall(function()
				return loadstring(game:HttpGet("https://cdn.jsdelivr.net/gh/melatonin-rs/lucide-luau@main/src/init.luau"))()
			end)
			if ok and type(module) == "table" and module.get then
				M.lucide = module
			else
				M.lucide = false
			end
		end
	end
	if not M.lucide then return nil end
	local ok, assetId = pcall(M.lucide.get, iconName, 96)
	if ok and type(assetId) == "string" and assetId ~= "" then
		return assetId
	end
	return nil
end

