	}, header)

	-- Статус справа: зелёная точка с пульсом, ONLINE и версия
	new("TextLabel", {
		Name = "Online",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromOffset(W - 11, 21),
		Size = UDim2.fromOffset(56, 18),
		BackgroundTransparency = 1,
		Text = "ONLINE",
		Font = M.FONT,
		TextSize = 15,
		TextColor3 = C.online,
		TextXAlignment = Enum.TextXAlignment.Right,
	}, header)
	new("TextLabel", {
		Name = "Version",
		AnchorPoint = Vector2.new(1, 0.5),
		Position = UDim2.fromOffset(W - 11, 38),
		Size = UDim2.fromOffset(120, 16),
		BackgroundTransparency = 1,
		Text = "v3.0 - BETA",
		Font = M.FONT,
		TextSize = 12,
		TextColor3 = C.version,
		TextXAlignment = Enum.TextXAlignment.Right,
	}, header)
	local dotX = W - 11 - 56 - 8
	local ring = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(dotX, 21),
		Size = UDim2.fromOffset(7, 7),
