local M = _G.AmodM
if not M then
	warn("[A-mod] Сначала запусти ЧАСТЬ 1")
else
	M.run(function()
		local C, new, corner, stroke, tw, bind = M.C, M.new, M.corner, M.stroke, M.tw, M.bind
		local FONT = M.FONT
		local UserInputService = game:GetService("UserInputService")

		M.controls = {} -- все галочки и ползунки по названию, чтобы потом навесить функции

		-- Блокировка скролла, пока двигаешь ползунок
		function M.setScrollLock(locked)
			for _, scroller in ipairs(M.scrollFrames) do
				scroller.ScrollingEnabled = not locked
			end
		end

		-- Линия из скруглённого Frame (для галочки), координаты в клетке size x size
		local function segment(parent, x1, y1, x2, y2, thickness, size, color)
			local dx, dy = x2 - x1, y2 - y1
			local length = math.sqrt(dx * dx + dy * dy)
			local frame = new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale((x1 + x2) / 2 / size, (y1 + y2) / 2 / size),
				Size = UDim2.fromScale((length + thickness * 0.5) / size, thickness / size),
				Rotation = math.deg(math.atan2(dy, dx)),
				BackgroundColor3 = color,
				BorderSizePixel = 0,
			}, parent)
			corner(frame, 99)
			return frame
		end

		-- Линия-разделитель с затуханием по краям
		local function fadeLine(parent, x, y, width)
			local line = new("Frame", {
				Position = UDim2.fromOffset(x, y),
				Size = width,
				BackgroundColor3 = C.line,
				BorderSizePixel = 0,
			}, parent)
			new("UIGradient", {
				Transparency = NumberSequence.new({
					NumberSequenceKeypoint.new(0, 0.9),
					NumberSequenceKeypoint.new(0.5, 0),
					NumberSequenceKeypoint.new(1, 0.9),
				}),
			}, line)
			return line
		end
		M.fadeLine = fadeLine

		-- Заголовок раздела: маленькая полоска, название, линия под ним (высота 43)
		local function sectionHeader(parent, order, text)
			local block = new("Frame", {
				Name = "Section",
				LayoutOrder = order,
				Size = UDim2.new(1, 0, 0, 43),
				BackgroundTransparency = 1,
			}, parent)
			new("Frame", {
				Position = UDim2.fromOffset(0, 9),
				Size = UDim2.fromOffset(2, 13),
				BackgroundColor3 = C.sectionBar,
				BorderSizePixel = 0,
			}, block)
			new("TextLabel", {
				Position = UDim2.fromOffset(9, 0),
				Size = UDim2.new(1, -9, 0, 30),
				BackgroundTransparency = 1,
				Text = text,
				Font = FONT,
				TextSize = 13,
				TextColor3 = C.section,
				TextXAlignment = Enum.TextXAlignment.Left,
			}, block)
			fadeLine(block, 0, 35, UDim2.new(1, 0, 0, 1))
			return block
		end

		-- Галочка с названием: плавная смена цвета, появление галочки, наведение и нажатие
		function M.checkRow(parent, order, text, initial, indent, textSize)
			local x0 = indent or 0
			local row = new("TextButton", {
				Name = "Check",
				LayoutOrder = order,
				Size = UDim2.new(1, 0, 0, 22),
				BackgroundTransparency = 1,
				Text = "",
				AutoButtonColor = false,
			}, parent)
			local box = new("Frame", {
				AnchorPoint = Vector2.new(0, 0.5),
				Position = UDim2.new(0, x0, 0.5, 0),
				Size = UDim2.fromOffset(15, 15),
				BackgroundColor3 = initial and C.boxOn or C.boxOff,
				BorderSizePixel = 0,
			}, row)
			corner(box, 3)
			local boxStroke = stroke(box, initial and C.boxOn or C.boxEdge, 1, 0)
			local boxScale = new("UIScale", { Scale = 1 }, box)
			local mark = new("Frame", {
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				Visible = initial,
			}, box)
			local markScale = new("UIScale", { Scale = initial and 1 or 0.2 }, mark)
			segment(mark, 3.4, 7.6, 6.2, 10.2, 2, 15, C.check)
			segment(mark, 6.2, 10.2, 11.6, 4.8, 2, 15, C.check)
			local label = new("TextLabel", {
				Position = UDim2.new(0, x0 + 22, 0, 0),
				Size = UDim2.new(1, -(x0 + 22), 1, 0),
				BackgroundTransparency = 1,
				Text = text,
				Font = FONT,
				TextSize = textSize or 12,
				TextColor3 = C.label,
				TextXAlignment = Enum.TextXAlignment.Left,
			}, row)

			local control = { row = row, text = text }
			local state = initial
			local token = 0

			function control.get()
				return state
			end

			function control.set(value, animate)
				state = value
				token = token + 1
				local mine = token
				local boxColor = value and C.boxOn or C.boxOff
				local edgeColor = value and C.boxOn or C.boxEdge
				if animate == false then
					box.BackgroundColor3 = boxColor
					boxStroke.Color = edgeColor
					mark.Visible = value
					markScale.Scale = value and 1 or 0.2
					return
				end
				tw(box, 0.16, { BackgroundColor3 = boxColor }, Enum.EasingStyle.Quad)
				tw(boxStroke, 0.16, { Color = edgeColor }, Enum.EasingStyle.Quad)
				if value then
					mark.Visible = true
					markScale.Scale = 0.2
					tw(markScale, 0.26, { Scale = 1 }, Enum.EasingStyle.Back)
				else
					tw(markScale, 0.14, { Scale = 0.2 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
					task.delay(0.15, function()
						if token == mine and not state then
							mark.Visible = false
						end
					end)
				end
			end

			row.MouseEnter:Connect(function()
				tw(label, 0.12, { TextColor3 = C.labelHover }, Enum.EasingStyle.Quad)
				if not state then
					tw(boxStroke, 0.12, { Color = C.accent }, Enum.EasingStyle.Quad)
				end
			end)
			row.MouseLeave:Connect(function()
				tw(label, 0.18, { TextColor3 = C.label }, Enum.EasingStyle.Quad)
				tw(boxStroke, 0.18, { Color = state and C.boxOn or C.boxEdge }, Enum.EasingStyle.Quad)
				tw(boxScale, 0.12, { Scale = 1 }, Enum.EasingStyle.Quad)
			end)
			row.MouseButton1Down:Connect(function()
				tw(boxScale, 0.1, { Scale = 0.85 }, Enum.EasingStyle.Quad)
			end)
			row.MouseButton1Up:Connect(function()
				tw(boxScale, 0.2, { Scale = 1 }, Enum.EasingStyle.Back)
			end)
			row.Activated:Connect(function()
				control.set(not state)
				if control.onChanged then
					control.onChanged(state)
				end
			end)

			M.controls[text] = control
			return control
		end

		-- Ползунок: тянется пальцем или мышкой, значение справа, плавная заливка
		function M.sliderRow(parent, order, text, minValue, maxValue, initial, decimals, rowWidth)
			local labelWidth = 78
			local trackWidth = math.min(173, rowWidth - labelWidth - 4)
			local minCenter, maxCenter = 11, trackWidth - 37
			local row = new("Frame", {
				Name = "Slider",
				LayoutOrder = order,
				Size = UDim2.new(1, 0, 0, 30),
				BackgroundTransparency = 1,
			}, parent)
			new("TextLabel", {
				Size = UDim2.fromOffset(labelWidth, 30),
				BackgroundTransparency = 1,
				Text = text,
				Font = FONT,
				TextSize = 12,
				TextColor3 = C.label,
				TextXAlignment = Enum.TextXAlignment.Left,
			}, row)
			local track = new("Frame", {
				Position = UDim2.fromOffset(labelWidth + 4, 3),
				Size = UDim2.fromOffset(trackWidth, 23),
				BackgroundColor3 = C.trackBg,
				BorderSizePixel = 0,
			}, row)
			corner(track, 99)
			local fill = new("Frame", {
				Size = UDim2.new(0.5, 0, 1, 0),
				BackgroundColor3 = C.fill,
				BorderSizePixel = 0,
			}, track)
			corner(fill, 99)
			local knob = new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(18, 18),
				BackgroundColor3 = C.knob,
				BorderSizePixel = 0,
				ZIndex = 2,
			}, track)
			corner(knob, 99)
			local knobScale = new("UIScale", { Scale = 1 }, knob)
			local knobCore = new("Frame", {
				AnchorPoint = Vector2.new(0.5, 0.5),
				Position = UDim2.fromScale(0.5, 0.5),
				Size = UDim2.fromOffset(8, 8),
				BackgroundColor3 = C.fill,
				BorderSizePixel = 0,
				ZIndex = 3,
			}, knob)
			corner(knobCore, 99)
			local valueLabel = new("TextLabel", {
				AnchorPoint = Vector2.new(1, 0),
				Position = UDim2.fromOffset(trackWidth - 6, 0),
				Size = UDim2.fromOffset(30, 23),
				BackgroundTransparency = 1,
				Font = FONT,
				TextSize = 12,
				TextColor3 = C.value,
				TextXAlignment = Enum.TextXAlignment.Right,
				ZIndex = 2,
			}, track)

			local format = "%." .. tostring(decimals or 0) .. "f"
			local step = 10 ^ -(decimals or 0)
			local control = { row = row, text = text, value = initial }

			local function render(fraction, animate)
				local center = minCenter + fraction * (maxCenter - minCenter)
				local knobPos = UDim2.fromScale(center / trackWidth, 0.5)
				local fillSize = UDim2.new((center + 3) / trackWidth, 0, 1, 0)
				if animate then
					tw(knob, 0.14, { Position = knobPos }, Enum.EasingStyle.Quad)
					tw(fill, 0.14, { Size = fillSize }, Enum.EasingStyle.Quad)
				else
					knob.Position = knobPos
					fill.Size = fillSize
				end
			end

			function control.set(value, animate)
				value = math.clamp(value, minValue, maxValue)
				control.value = value
				render((value - minValue) / (maxValue - minValue), animate)
				valueLabel.Text = string.format(format, value)
			end

			function control.get()
				return control.value
			end

			-- Перевод позиции пальца на экране в значение
			function control.update(screenX, animate)
				local relative = (screenX - track.AbsolutePosition.X) / math.max(track.AbsoluteSize.X, 1) * trackWidth
				local fraction = math.clamp((relative - minCenter) / (maxCenter - minCenter), 0, 1)
				local raw = minValue + fraction * (maxValue - minValue)
				local value = math.floor(raw / step + 0.5) * step
				control.set(value, animate)
				if control.onChanged then
					control.onChanged(control.value)
				end
			end

			control.set(initial, false)

			track.InputBegan:Connect(function(input)
				if input.UserInputType == Enum.UserInputType.MouseButton1
					or input.UserInputType == Enum.UserInputType.Touch then
					M.activeSlider = control
					M.activeKnobScale = knobScale
					M.setScrollLock(true)
					tw(knobScale, 0.14, { Scale = 1.18 }, Enum.EasingStyle.Back)
					control.update(input.Position.X, true)
				end
			end)

			M.controls[text] = control
			return control
		end

		-- Общие обработчики перетаскивания ползунка (по одному на все ползунки)
		bind(UserInputService.InputChanged, function(input)
			if M.activeSlider and (input.UserInputType == Enum.UserInputType.MouseMovement
				or input.UserInputType == Enum.UserInputType.Touch) then
				M.activeSlider.update(input.Position.X, false)
			end
		end)
		bind(UserInputService.InputEnded, function(input)
			if M.activeSlider and (input.UserInputType == Enum.UserInputType.MouseButton1
				or input.UserInputType == Enum.UserInputType.Touch) then
				if M.activeKnobScale then
					tw(M.activeKnobScale, 0.2, { Scale = 1 }, Enum.EasingStyle.Back)
				end
				M.activeSlider = nil
				M.activeKnobScale = nil
				M.setScrollLock(false)
			end
		end)

		-- Тени сверху и снизу панели: показывают, что список можно крутить
		local function attachFades(body, panel)
			local function makeFade(atTop)
				local fade = new("Frame", {
					Position = atTop and UDim2.fromOffset(1, 1) or UDim2.new(0, 1, 1, -17),
					Size = UDim2.new(1, -6, 0, 16),
					BackgroundColor3 = C.panel,
					BackgroundTransparency = 1,
					BorderSizePixel = 0,
					ZIndex = 5,
				}, panel)
				new("UIGradient", {
					Rotation = 90,
					Transparency = NumberSequence.new({
						NumberSequenceKeypoint.new(0, atTop and 0 or 1),
						NumberSequenceKeypoint.new(1, atTop and 1 or 0),
					}),
				}, fade)
				return fade
			end
			local topFade, bottomFade = makeFade(true), makeFade(false)
			local topOn, bottomOn = false, false
			local function refresh()
				local maxY = body.AbsoluteCanvasSize.Y - body.AbsoluteWindowSize.Y
				local y = body.CanvasPosition.Y
				local wantTop = y > 2
				local wantBottom = maxY - y > 2
				if wantTop ~= topOn then
					topOn = wantTop
					tw(topFade, 0.2, { BackgroundTransparency = wantTop and 0 or 1 }, Enum.EasingStyle.Quad)
				end
				if wantBottom ~= bottomOn then
					bottomOn = wantBottom
					tw(bottomFade, 0.2, { BackgroundTransparency = wantBottom and 0 or 1 }, Enum.EasingStyle.Quad)
				end
			end
			body:GetPropertyChangedSignal("CanvasPosition"):Connect(refresh)
			body:GetPropertyChangedSignal("AbsoluteCanvasSize"):Connect(refresh)
			body:GetPropertyChangedSignal("AbsoluteWindowSize"):Connect(refresh)
			task.defer(refresh)
		end

		-- Панель со списком и скроллом. sections = { { title = "...", rows = { ... } } }
		-- Строки: { "check", "Текст", включено, отступ } или { "slider", "Текст:", мин, макс, значение, знаков }
		function M.buildPanel(parent, x, y, width, height, sections)
			local panel = new("Frame", {
				Position = UDim2.fromOffset(x, y),
				Size = UDim2.fromOffset(width, height),
				BackgroundColor3 = C.panel,
				BorderSizePixel = 0,
				ClipsDescendants = true,
			}, parent)
			corner(panel, 2)
			stroke(panel, C.panelEdge, 1, 0)

			local body = new("ScrollingFrame", {
				Size = UDim2.fromScale(1, 1),
				BackgroundTransparency = 1,
				BorderSizePixel = 0,
				ScrollBarThickness = 3,
				ScrollBarImageColor3 = C.scroll,
				CanvasSize = UDim2.new(),
				AutomaticCanvasSize = Enum.AutomaticSize.Y,
				ScrollingDirection = Enum.ScrollingDirection.Y,
				VerticalScrollBarInset = Enum.ScrollBarInset.None,
			}, panel)
			new("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder }, body)
			new("UIPadding", {
				PaddingLeft = UDim.new(0, 8),
				PaddingRight = UDim.new(0, 12),
				PaddingBottom = UDim.new(0, 8),
			}, body)
			M.scrollFrames[#M.scrollFrames + 1] = body

			local rowWidth = width - 20
			local order = 0
			for _, section in ipairs(sections) do
				order = order + 1
				sectionHeader(body, order, section.title)
				for _, row in ipairs(section.rows) do
					order = order + 1
					if row[1] == "check" then
						M.checkRow(body, order, row[2], row[3], row[4])
					else
						M.sliderRow(body, order, row[2], row[3], row[4], row[5], row[6], rowWidth)
					end
				end
			end

			attachFades(body, panel)
			return panel, body
		end

		-- Главная галочка над правой панелью с линией под ней
		function M.buildMaster(parent, x, y, width, text, initial)
			local holder = new("Frame", {
				Position = UDim2.fromOffset(x, y),
				Size = UDim2.fromOffset(width, 31),
				BackgroundTransparency = 1,
			}, parent)
			local control = M.checkRow(holder, 0, text, initial, 0, 13)
			control.row.Position = UDim2.fromOffset(10, 0)
			control.row.Size = UDim2.new(1, -10, 0, 30)
			fadeLine(holder, 0, 30, UDim2.new(1, 0, 0, 1))
			return control
		end
	end)
end
