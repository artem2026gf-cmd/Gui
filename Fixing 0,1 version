	})
	ringLoop:Play()
	M.loops[#M.loops + 1] = ringLoop
	local dot = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromOffset(dotX, 21),
		Size = UDim2.fromOffset(7, 7),
		BackgroundColor3 = C.online,
		BorderSizePixel = 0,
	}, header)
	M.corner(dot, 99)

	-- Перетаскивание окна за шапку
	local dragging = false
	local dragStart, startPos
	bind(header.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = true
			dragStart = input.Position
			startPos = root.Position
		end
	end)
	bind(UserInputService.InputChanged, function(input)
		if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - dragStart
			root.Position = UDim2.new(
				startPos.X.Scale, startPos.X.Offset + delta.X,
				startPos.Y.Scale, startPos.Y.Offset + delta.Y
			)
		end
	end)
	bind(UserInputService.InputEnded, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			dragging = false
		end
	end)

	-- Подгон размера окна под экран
	M.fitScale = 1
	M.isOpen = false
	function M.curScale()
		return M.manualScale or M.fitScale
	end

	function M.refit()
		local camera = workspace.CurrentCamera
		if not camera then return end
		local view = camera.ViewportSize
		M.fitScale = math.clamp(math.min(view.X * 0.96 / W, view.Y * 0.9 / H), 0.5, 1.6)
		if M.isOpen then
			rootScale.Scale = M.curScale()
		end
	end

	-- Открытие и закрытие
	function M.setOpen(open)
		M.isOpen = open
		local scale = M.curScale()
		for _, loop in ipairs(M.loops) do
			if open then loop:Play() else task.delay(0.3, function() if not M.isOpen then loop:Pause() end end) end
		end
		if open then
			root.Visible = true
			rootScale.Scale = scale * 0.92
			veil.BackgroundTransparency = 0
			tw(veil, 0.4, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
			tw(rootScale, 0.5, { Scale = scale }, Enum.EasingStyle.Quint)
			tw(M.edgeStroke, 0.4, { Transparency = 0.1 }, Enum.EasingStyle.Quad)
			for _, shadow in ipairs(M.shadows) do
				shadow.obj.BackgroundTransparency = 1
				tw(shadow.obj, 0.5, { BackgroundTransparency = shadow.base }, Enum.EasingStyle.Quad)
			end
		else
			tw(veil, 0.22, { BackgroundTransparency = 0 }, Enum.EasingStyle.Quad)
			tw(rootScale, 0.25, { Scale = scale * 0.94 }, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
			tw(M.edgeStroke, 0.25, { Transparency = 1 }, Enum.EasingStyle.Quad)
			for _, shadow in ipairs(M.shadows) do
				tw(shadow.obj, 0.25, { BackgroundTransparency = 1 }, Enum.EasingStyle.Quad)
			end
			task.delay(0.28, function()
				if not M.isOpen then
					root.Visible = false
				end
			end)
		end
	end

	function M.toggle()
		M.setOpen(not M.isOpen)
	end

	-- Линия снизу экрана по центру: нажми, чтобы открыть или закрыть меню
	local handle = new("TextButton", {
		Name = "Handle",
		AnchorPoint = Vector2.new(0.5, 1),
		Position = UDim2.new(0.5, 0, 1, -3),
		Size = UDim2.fromOffset(220, 28),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 50,
	}, gui)
	local handleLine = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(120, 4),
		BackgroundColor3 = Color3.fromRGB(255, 255, 255),
		BackgroundTransparency = 0.5,
		BorderSizePixel = 0,
	}, handle)
	M.corner(handleLine, 99)
	bind(handle.MouseEnter, function()
		tw(handleLine, 0.2, { Size = UDim2.fromOffset(160, 4), BackgroundTransparency = 0.15 })
	end)
	bind(handle.MouseLeave, function()
		tw(handleLine, 0.25, { Size = UDim2.fromOffset(120, 4), BackgroundTransparency = 0.5 })
	end)
	bind(handle.Activated, function()
		M.toggle()
	end)

	-- Клавиша K тоже открывает и закрывает
	bind(UserInputService.InputBegan, function(input, processed)
		if not processed and input.KeyCode == Enum.KeyCode.K then
			M.toggle()
		end
	end)


	-- ===== Уголок справа внизу: тянешь, чтобы менять размер меню вручную =====
	local grip = new("TextButton", {
		Name = "ResizeGrip",
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.new(1, -3, 1, -3),
		Size = UDim2.fromOffset(34, 34),
		BackgroundTransparency = 1,
		Text = "",
		AutoButtonColor = false,
		ZIndex = 60,
	}, root)
	local gripBg = new("Frame", {
		AnchorPoint = Vector2.new(0.5, 0.5),
		Position = UDim2.fromScale(0.5, 0.5),
		Size = UDim2.fromOffset(22, 22),
		BackgroundColor3 = C.tabSel,
		BackgroundTransparency = 0.1,
		BorderSizePixel = 0,
		ZIndex = 60,
	}, grip)
	M.corner(gripBg, 99)
	local gripStroke = M.stroke(gripBg, C.accent, 1, 0.55)
	local gripIcon = M.icon(gripBg, "resize", C.tabOn, 12)
	for _, part in ipairs(gripIcon.holder:GetDescendants()) do
		if part:IsA("GuiObject") then part.ZIndex = 61 end
	end
	M.gripIcon = gripIcon

	local resizing = false
	local rStart, rStartScale, rStartPos
	local lastTap = 0
	bind(grip.MouseEnter, function()
		tw(gripBg, 0.18, { Size = UDim2.fromOffset(26, 26), BackgroundTransparency = 0 })
		tw(gripStroke, 0.18, { Transparency = 0.1 })
	end)
	bind(grip.MouseLeave, function()
		if not resizing then
			tw(gripBg, 0.22, { Size = UDim2.fromOffset(22, 22), BackgroundTransparency = 0.1 })
			tw(gripStroke, 0.22, { Transparency = 0.55 })
		end
	end)
	bind(grip.InputBegan, function(input)
		if input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch then
			resizing = true
			rStart = input.Position
			rStartScale = rootScale.Scale
			rStartPos = root.Position
			tw(gripBg, 0.15, { Size = UDim2.fromOffset(28, 28) }, Enum.EasingStyle.Back)
			tw(gripStroke, 0.15, { Transparency = 0 })
			-- двойное касание: вернуть размер по умолчанию
			if os.clock() - lastTap < 0.35 then
				resizing = false
				M.manualScale = nil
				M.refit()
				tw(rootScale, 0.3, { Scale = M.fitScale }, Enum.EasingStyle.Back)
				if M.toast then M.toast("Size reset") end
			end
			lastTap = os.clock()
		end
	end)
	bind(UserInputService.InputChanged, function(input)
		if resizing and (input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch) then
			local delta = input.Position - rStart
			-- по диагонали: ширина и высота растут вместе
			local grow = (delta.X + delta.Y * (W / H)) / 2
			local wanted = (W * rStartScale + grow) / W
			local newScale = math.clamp(wanted, 0.45, math.max(M.fitScale * 1.6, 1))
			M.manualScale = newScale
			rootScale.Scale = newScale
			-- верхний левый угол остаётся на месте, угол тянется за пальцем
			local diff = newScale - rStartScale
			root.Position = UDim2.new(
				rStartPos.X.Scale, rStartPos.X.Offset + W * diff / 2,
				rStartPos.Y.Scale, rStartPos.Y.Offset + H * diff / 2
			)
		end
	end)
	bind(UserInputService.InputEnded, function(input)
		if resizing and (input.UserInputType == Enum.UserInputType.MouseButton1
			or input.UserInputType == Enum.UserInputType.Touch) then
			resizing = false
			tw(gripBg, 0.22, { Size = UDim2.fromOffset(22, 22) }, Enum.EasingStyle.Back)
			tw(gripStroke, 0.22, { Transparency = 0.55 })
		end
	end)

	M.refit()
end)

end
-- A-mod menu | ЧАСТЬ 3/5: боковая панель с иконками и эффект вкладки
local M = _G.AmodM
if not M then
	warn("[A-mod] Сначала запусти ЧАСТЬ 1")
else
	M.run(function()
		local C, new, corner, tw, bind = M.C, M.new, M.corner, M.tw, M.bind
		local window = M.window
		local HEADER_H, SIDE_W, CW, CH = M.HEADER_H, M.SIDE_W, M.CW, M.CH

		local TAB_NAMES = { "Combat", "Movement", "Visuals", "Misc", "Skins", "Crosshair", "Scripts" }
		local TAB_ICONS = { "sword", "run", "eye", "gear", "gem", "cross", "code" }
		local TAB_W, TAB_H, TAB_PITCH, TAB_TOP = 49, 48, 49, 2
		M.TAB_NAMES = TAB_NAMES

		local function tabTop(index)
			return TAB_TOP + (index - 1) * TAB_PITCH
		end

		-- Боковая панель (градиент задаёт цвет, поэтому фон белый)
		local sidebar = new("Frame", {
			Name = "Sidebar",
			Position = UDim2.fromOffset(0, HEADER_H),
			Size = UDim2.fromOffset(SIDE_W, CH),
			BackgroundColor3 = Color3.fromRGB(255, 255, 255),
			BorderSizePixel = 0,
		}, window)
		new("UIGradient", {
			Rotation = 90,
			Color = ColorSequence.new(Color3.fromRGB(20, 25, 36), Color3.fromRGB(16, 20, 29)),
		}, sidebar)
		new("Frame", {
			Name = "Edge",
